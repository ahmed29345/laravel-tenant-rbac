{
    "name": "ahmed29345/laravel-tenant-rbac",
    "description": "Multi-tenant roles, permissions and automatic data scoping for Laravel.",
    "keywords": ["laravel", "multi-tenancy", "rbac", "roles", "permissions", "authorization", "saas"],
    "homepage": "https://github.com/ahmed29345/laravel-tenant-rbac",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Ahmed Raza Memon",
            "homepage": "https://github.com/ahmed29345"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.5.35|^11.5.3|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmed29345\\TenantRbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmed29345\\TenantRbac\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmed29345\\TenantRbac\\TenantRbacServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
